{%- liquid
  assign hero_product = section.settings.hero_product
  assign feature_product = section.settings.feature_product
  assign product_collection = section.settings.product_collection
-%}

<section class="hero" id="TheosHero-{{ section.id }}">
  <div class="hero__grid shell">
    <div class="hero__copy">
      <p class="kicker reveal"><span>{{ section.settings.hero_kicker_accent | escape }}</span>{{ section.settings.hero_kicker | escape }}</p>
      <h1 class="hero__title reveal">
        <span>{{ section.settings.hero_title | escape }}</span>
        <span class="hero__title--outline">{{ section.settings.hero_title_outline | escape }}</span>
      </h1>
      <p class="hero__lede reveal">{{ section.settings.hero_text | escape | newline_to_br }}</p>
      <div class="hero__actions reveal">
        <a class="button button--light magnetic" href="{{ section.settings.hero_primary_link | default: routes.all_products_collection_url }}">
          {{ section.settings.hero_primary_label | escape }}
          <svg><use href="#icon-arrow"></use></svg>
        </a>
        {%- if hero_product != blank -%}
          <a class="text-link" href="{{ hero_product.url }}">{{ section.settings.hero_secondary_label | escape }} <span>↘</span></a>
        {%- elsif section.settings.hero_secondary_link != blank -%}
          <a class="text-link" href="{{ section.settings.hero_secondary_link }}">{{ section.settings.hero_secondary_label | escape }} <span>↘</span></a>
        {%- endif -%}
      </div>
      <div class="hero__meta reveal">
        <div><strong>{{ section.settings.stat_1_value | escape }}</strong><small>{{ section.settings.stat_1_label | escape }}</small></div>
        <div><strong>{{ section.settings.stat_2_value | escape }}</strong><small>{{ section.settings.stat_2_label | escape }}</small></div>
        <div><strong>{{ section.settings.stat_3_value | escape }}</strong><small>{{ section.settings.stat_3_label | escape }}</small></div>
      </div>
    </div>

    <div class="hero__visual">
      <span class="hero__index" aria-hidden="true">{{ section.settings.hero_index | escape }}</span>
      <div class="hero__orb" aria-hidden="true"></div>
      {%- if hero_product != blank and hero_product.featured_image != blank -%}
        <a class="hero__product-link" href="{{ hero_product.url }}" aria-label="{{ hero_product.title | escape }}">
          {{
            hero_product.featured_image
            | image_url: width: 1500
            | image_tag:
              widths: '540, 720, 960, 1200, 1500',
              sizes: '(min-width: 900px) 50vw, 90vw',
              class: 'hero__product hero__product--image',
              fetchpriority: 'high',
              alt: hero_product.featured_image.alt
          }}
        </a>
      {%- else -%}
        <div class="hero__product">{% render 'product-art', art: section.settings.hero_art %}</div>
      {%- endif -%}
      <div class="spec-tag spec-tag--top">
        <span>{{ section.settings.hero_tag_1_label | escape }}</span>
        <strong>{{ section.settings.hero_tag_1_value | escape }}</strong>
      </div>
      <div class="spec-tag spec-tag--bottom">
        <span>{{ section.settings.hero_tag_2_label | escape }}</span>
        <strong>{{ section.settings.hero_tag_2_value | escape }}</strong>
      </div>
      <p class="hero__edition">
        {%- if hero_product != blank -%}{{ hero_product.title | escape }}{%- else -%}{{ section.settings.hero_edition | escape }}{%- endif -%}
      </p>
    </div>
  </div>
  <a class="scroll-cue" href="#TheosCategories-{{ section.id }}" aria-label="Scroll to collections">
    <span>Scroll to discover</span><i></i>
  </a>
</section>

<section class="category-section" id="TheosCategories-{{ section.id }}">
  <div class="shell">
    <header class="section-heading reveal">
      <div>
        <p class="kicker kicker--dark"><span>{{ section.settings.categories_kicker | escape }}</span>{{ section.settings.categories_kicker_tail | escape }}</p>
        <h2>{{ section.settings.categories_heading | escape | newline_to_br }}</h2>
      </div>
      <p>{{ section.settings.categories_text | escape }}</p>
    </header>

    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- liquid
            assign block_collection = block.settings.collection
            assign category_url = routes.all_products_collection_url
            if block_collection != blank
              assign category_url = block_collection.url
            endif
            assign category_image = block.settings.image
            if category_image == blank and block_collection.image != blank
              assign category_image = block_collection.image
            endif
            if category_image == blank and block_collection.products.first.featured_image != blank
              assign category_image = block_collection.products.first.featured_image
            endif
          -%}
          <a
            class="category-card category-card--{{ block.settings.art }} category-card--{{ block.settings.color_style }} reveal"
            href="{{ category_url }}"
            aria-label="{{ block.settings.label | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="category-card__top">
              <span>{{ forloop.index | prepend: '0' }} / {{ block.settings.label | escape }}</span>
              <i>Explore</i>
            </div>
            {%- if category_image != blank -%}
              {{
                category_image
                | image_url: width: 1300
                | image_tag:
                  loading: 'lazy',
                  widths: '420, 640, 860, 1100, 1300',
                  sizes: '(min-width: 900px) 50vw, 100vw',
                  class: 'category-card__image',
                  alt: category_image.alt
              }}
            {%- else -%}
              {% render 'product-art', art: block.settings.art %}
            {%- endif -%}
            <div class="category-card__foot">
              <h3>{{ block.settings.headline | escape | newline_to_br }}</h3>
              <span class="circle-arrow">↗</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<div class="velocity-band" aria-hidden="true">
  <div>
    <span>{{ section.settings.marquee_text | escape }}</span><i>THEOS</i>
    <span>{{ section.settings.marquee_text | escape }}</span><i>THEOS</i>
    <span>{{ section.settings.marquee_text | escape }}</span><i>THEOS</i>
  </div>
</div>

<section class="feature-section" id="TheosFeature-{{ section.id }}">
  <div class="feature__visual">
    <span class="feature__ghost" aria-hidden="true">{{ section.settings.feature_ghost | escape }}</span>
    {%- if feature_product != blank and feature_product.featured_image != blank -%}
      {{
        feature_product.featured_image
        | image_url: width: 1500
        | image_tag:
          loading: 'lazy',
          widths: '540, 720, 960, 1200, 1500',
          sizes: '(min-width: 900px) 50vw, 100vw',
          class: 'feature__product-image',
          alt: feature_product.featured_image.alt
      }}
    {%- else -%}
      {% render 'product-art', art: section.settings.feature_art %}
    {%- endif -%}
    <div class="feature__callout feature__callout--one"><i></i><span>{{ section.settings.feature_callout_1 | escape | newline_to_br }}</span></div>
    <div class="feature__callout feature__callout--two"><i></i><span>{{ section.settings.feature_callout_2 | escape | newline_to_br }}</span></div>
  </div>

  <div class="feature__copy">
    <p class="kicker"><span>{{ section.settings.feature_kicker_accent | escape }}</span>{{ section.settings.feature_kicker | escape }}</p>
    <h2>{{ section.settings.feature_heading | escape | newline_to_br }}</h2>
    <p>
      {%- if feature_product != blank and feature_product.description != blank -%}
        {{ feature_product.description | strip_html | truncate: 310 }}
      {%- else -%}
        {{ section.settings.feature_text | escape }}
      {%- endif -%}
    </p>
    <div class="feature__specs">
      <div><span>01</span><p><strong>{{ section.settings.feature_spec_1_title | escape }}</strong>{{ section.settings.feature_spec_1_text | escape }}</p></div>
      <div><span>02</span><p><strong>{{ section.settings.feature_spec_2_title | escape }}</strong>{{ section.settings.feature_spec_2_text | escape }}</p></div>
      <div><span>03</span><p><strong>{{ section.settings.feature_spec_3_title | escape }}</strong>{{ section.settings.feature_spec_3_text | escape }}</p></div>
    </div>
    <div class="feature__buy">
      <div>
        <span>{% if feature_product != blank %}{{ feature_product.title | escape }}{% else %}{{ section.settings.feature_product_label | escape }}{% endif %}</span>
        <strong>{% if feature_product != blank %}{{ feature_product.price | money }}{% else %}Add a featured product{% endif %}</strong>
      </div>
      {%- if feature_product != blank -%}
        {%- if feature_product.has_only_default_variant and feature_product.available -%}
          {%- assign feature_variant = feature_product.selected_or_first_available_variant -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="js-product-form" data-product-title="{{ feature_product.title | escape }}">
            <input type="hidden" name="id" value="{{ feature_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="button button--orange magnetic" type="submit" data-ajax-add>
              Add to setup <svg><use href="#icon-plus"></use></svg>
            </button>
          </form>
        {%- else -%}
          <a class="button button--orange magnetic" href="{{ feature_product.url }}">
            Choose options <svg><use href="#icon-arrow"></use></svg>
          </a>
        {%- endif -%}
      {%- else -%}
        <a class="button button--orange magnetic" href="{{ routes.all_products_collection_url }}">Shop all <svg><use href="#icon-arrow"></use></svg></a>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="products-section" id="TheosProducts-{{ section.id }}">
  <div class="shell">
    <header class="products__header reveal">
      <div>
        <p class="kicker"><span>{{ section.settings.products_kicker | escape }}</span>{{ section.settings.products_kicker_tail | escape }}</p>
        <h2>{{ section.settings.products_heading | escape | newline_to_br }}</h2>
      </div>
      {%- if section.settings.enable_filters -%}
        <div class="product-tabs" role="group" aria-label="Filter products">
          <button class="is-active" type="button" data-filter="all">All</button>
          <button type="button" data-filter="{{ section.settings.filter_1_type | handleize }}">{{ section.settings.filter_1_label | escape }}</button>
          <button type="button" data-filter="{{ section.settings.filter_2_type | handleize }}">{{ section.settings.filter_2_label | escape }}</button>
          <button type="button" data-filter="{{ section.settings.filter_3_type | handleize }}">{{ section.settings.filter_3_label | escape }}</button>
        </div>
      {%- endif -%}
    </header>

    <div class="product-grid">
      {%- if product_collection != blank and product_collection.products_count > 0 -%}
        {%- for card_product in product_collection.products limit: section.settings.product_limit -%}
          {%- liquid
            case forloop.index
              when 2
                assign fallback_art = 'keyboard'
                assign color_style = 'silver'
              when 3
                assign fallback_art = 'desk'
                assign color_style = 'cream'
              else
                assign fallback_art = 'mouse'
                assign color_style = 'orange'
            endcase
          -%}
          {% render 'product-card',
            product_card_product: card_product,
            fallback_art: fallback_art,
            color_style: color_style,
            show_vendor: section.settings.show_vendor,
            card_index: forloop.index
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for placeholder_index in (1..3) -%}
          {%- liquid
            case placeholder_index
              when 2
                assign placeholder_art = 'keyboard'
                assign placeholder_color = 'silver'
                assign placeholder_title = 'Add your keyboard'
              when 3
                assign placeholder_art = 'desk'
                assign placeholder_color = 'cream'
                assign placeholder_title = 'Add your desk'
              else
                assign placeholder_art = 'mouse'
                assign placeholder_color = 'orange'
                assign placeholder_title = 'Add your mouse'
            endcase
          -%}
          <article class="product-card reveal" data-category="{{ placeholder_art }}">
            <div class="product-card__visual product-card__visual--{{ placeholder_color }}">
              <span class="product-badge">Theme editor</span>
              {% render 'product-art', art: placeholder_art %}
              <span class="product-code">THEOS // 0{{ placeholder_index }}</span>
            </div>
            <div class="product-card__info">
              <div><p>Choose a collection</p><h3>{{ placeholder_title }}</h3><span>Your Shopify products will appear here automatically.</span></div>
              <div class="product-card__price"><strong>—</strong></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<section class="engineering-section">
  <div class="engineering__intro shell">
    <div class="engineering__title reveal">
      <p class="kicker"><span>{{ section.settings.tech_kicker | escape }}</span>{{ section.settings.tech_kicker_tail | escape }}</p>
      <h2>{{ section.settings.tech_heading | escape | newline_to_br }}</h2>
    </div>
    <p class="engineering__lede reveal">{{ section.settings.tech_text | escape }}</p>
  </div>
  <div class="engineering-grid shell">
    <article class="tech-card tech-card--large reveal">
      <span class="tech-card__number">01</span>
      <div class="latency-visual" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><i>{{ section.settings.tech_1_metric | escape }}</i><small>{{ section.settings.tech_1_unit | escape }}</small></div>
      <div><p>{{ section.settings.tech_1_kicker | escape }}</p><h3>{{ section.settings.tech_1_heading | escape | newline_to_br }}</h3><span>{{ section.settings.tech_1_text | escape }}</span></div>
    </article>
    <article class="tech-card reveal">
      <span class="tech-card__number">02</span>
      <div class="sensor-visual" aria-hidden="true"><i></i><i></i><i></i><i></i><span>{{ section.settings.tech_2_metric | escape }}</span></div>
      <div><p>{{ section.settings.tech_2_kicker | escape }}</p><h3>{{ section.settings.tech_2_heading | escape | newline_to_br }}</h3><span>{{ section.settings.tech_2_text | escape }}</span></div>
    </article>
    <article class="tech-card tech-card--orange reveal">
      <span class="tech-card__number">03</span>
      <svg class="tech-logo" viewBox="0 0 68 54" aria-hidden="true"><use href="#theos-mark"></use></svg>
      <div><p>{{ section.settings.tech_3_kicker | escape }}</p><h3>{{ section.settings.tech_3_heading | escape | newline_to_br }}</h3><span>{{ section.settings.tech_3_text | escape }}</span></div>
    </article>
  </div>
</section>

<section class="manifesto-section">
  <div class="manifesto__media" aria-hidden="true">
    <div class="manifesto__lines"></div>
    {%- if section.settings.manifesto_image != blank -%}
      {{
        section.settings.manifesto_image
        | image_url: width: 1600
        | image_tag:
          loading: 'lazy',
          widths: '640, 900, 1200, 1600',
          sizes: '(min-width: 900px) 55vw, 100vw',
          class: 'manifesto__image',
          alt: section.settings.manifesto_image.alt
      }}
    {%- else -%}
      {% render 'product-art', art: 'keyboard' %}
    {%- endif -%}
    <span>{{ section.settings.manifesto_media_label | escape }}</span>
  </div>
  <div class="manifesto__copy">
    <p class="kicker"><span>{{ section.settings.manifesto_kicker | escape }}</span>{{ section.settings.manifesto_kicker_tail | escape }}</p>
    <h2>{{ section.settings.manifesto_heading | escape | newline_to_br }}</h2>
    <p>{{ section.settings.manifesto_text | escape }}</p>
    <blockquote>{{ section.settings.manifesto_quote | escape }}</blockquote>
    <a class="text-link text-link--dark" href="#TheosNewsletter-{{ section.id }}">{{ section.settings.manifesto_link_label | escape }} <span>↘</span></a>
  </div>
</section>

<section class="service-strip">
  <div class="shell">
    <div><span>01</span><p><strong>{{ section.settings.service_1_title | escape }}</strong>{{ section.settings.service_1_text | escape }}</p></div>
    <div><span>02</span><p><strong>{{ section.settings.service_2_title | escape }}</strong>{{ section.settings.service_2_text | escape }}</p></div>
    <div><span>03</span><p><strong>{{ section.settings.service_3_title | escape }}</strong>{{ section.settings.service_3_text | escape }}</p></div>
    <div><span>04</span><p><strong>{{ section.settings.service_4_title | escape }}</strong>{{ section.settings.service_4_text | escape }}</p></div>
  </div>
</section>

<section class="newsletter-section" id="TheosNewsletter-{{ section.id }}">
  <div class="newsletter__mark" aria-hidden="true"><svg viewBox="0 0 68 54"><use href="#theos-mark"></use></svg></div>
  <div class="newsletter__content shell">
    <p class="kicker"><span>{{ section.settings.newsletter_kicker | escape }}</span>{{ section.settings.newsletter_kicker_tail | escape }}</p>
    <h2>{{ section.settings.newsletter_heading | escape | newline_to_br }}</h2>
    <p>{{ section.settings.newsletter_text | escape }}</p>
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
      <input
        id="NewsletterEmail-{{ section.id }}"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        placeholder="{{ 'newsletter.email' | t | upcase }}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        required
      >
      <button type="submit">{{ section.settings.newsletter_button | escape }} <svg><use href="#icon-arrow"></use></svg></button>
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
    {%- endform -%}
    <p class="newsletter__fine">{{ section.settings.newsletter_fine | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Theos storefront",
  "tag": "section",
  "class": "theos-home",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "product", "id": "hero_product", "label": "Hero product" },
    { "type": "select", "id": "hero_art", "label": "Fallback product art", "options": [
      { "value": "mouse", "label": "Mouse" },
      { "value": "keyboard", "label": "Keyboard" },
      { "value": "desk", "label": "Desk" }
    ], "default": "mouse" },
    { "type": "text", "id": "hero_kicker_accent", "label": "Kicker accent", "default": "Series 01" },
    { "type": "text", "id": "hero_kicker", "label": "Kicker", "default": "Engineered for competition" },
    { "type": "text", "id": "hero_title", "label": "Title line 1", "default": "ZERO" },
    { "type": "text", "id": "hero_title_outline", "label": "Title line 2", "default": "HESITATION." },
    { "type": "textarea", "id": "hero_text", "label": "Text", "default": "Performance hardware tuned for speed, balance, and control. Designed to disappear between you and the win." },
    { "type": "text", "id": "hero_primary_label", "label": "Primary button", "default": "Shop performance" },
    { "type": "url", "id": "hero_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "hero_secondary_label", "label": "Secondary link", "default": "Meet the hero product" },
    { "type": "url", "id": "hero_secondary_link", "label": "Secondary link fallback" },
    { "type": "text", "id": "hero_index", "label": "Background index", "default": "01" },
    { "type": "text", "id": "hero_edition", "label": "Fallback edition label", "default": "THEOS // PERFORMANCE EDITION" },
    { "type": "text", "id": "hero_tag_1_label", "label": "Product tag 1 label", "default": "Performance" },
    { "type": "text", "id": "hero_tag_1_value", "label": "Product tag 1 value", "default": "TOURNAMENT READY" },
    { "type": "text", "id": "hero_tag_2_label", "label": "Product tag 2 label", "default": "Delivery" },
    { "type": "text", "id": "hero_tag_2_value", "label": "Product tag 2 value", "default": "FAST US SHIPPING" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "FAST" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Responsive hardware" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "PRO" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Built for play" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "30D" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Returns" },

    { "type": "header", "content": "Category grid" },
    { "type": "text", "id": "categories_kicker", "label": "Kicker accent", "default": "Shop" },
    { "type": "text", "id": "categories_kicker_tail", "label": "Kicker", "default": "Find your advantage" },
    { "type": "textarea", "id": "categories_heading", "label": "Heading", "default": "THE PERFORMANCE\nCOLLECTION." },
    { "type": "textarea", "id": "categories_text", "label": "Text", "default": "Every surface, switch, and component selected to keep up with instinct." },
    { "type": "text", "id": "marquee_text", "label": "Marquee text", "default": "NO LAG. NO DOUBT." },

    { "type": "header", "content": "Featured product" },
    { "type": "product", "id": "feature_product", "label": "Featured product" },
    { "type": "select", "id": "feature_art", "label": "Fallback art", "options": [
      { "value": "mouse", "label": "Mouse" },
      { "value": "keyboard", "label": "Keyboard" },
      { "value": "desk", "label": "Desk" }
    ], "default": "mouse" },
    { "type": "text", "id": "feature_ghost", "label": "Background text", "default": "PRO" },
    { "type": "text", "id": "feature_callout_1", "label": "Callout 1", "default": "BUILT FOR\nCONTROL" },
    { "type": "text", "id": "feature_callout_2", "label": "Callout 2", "default": "SELECTED FOR\nPERFORMANCE" },
    { "type": "text", "id": "feature_kicker_accent", "label": "Kicker accent", "default": "Featured" },
    { "type": "text", "id": "feature_kicker", "label": "Kicker", "default": "The Theos pick" },
    { "type": "textarea", "id": "feature_heading", "label": "Heading", "default": "PURE INTENT.\nNOTHING ELSE." },
    { "type": "textarea", "id": "feature_text", "label": "Fallback text", "default": "Purposeful hardware selected for performance, reliability, and a clean setup." },
    { "type": "text", "id": "feature_product_label", "label": "Fallback product label", "default": "FEATURED PRODUCT" },
    { "type": "text", "id": "feature_spec_1_title", "label": "Spec 1 title", "default": "PERFORMANCE FIRST" },
    { "type": "text", "id": "feature_spec_1_text", "label": "Spec 1 text", "default": "Selected to respond when the game demands it." },
    { "type": "text", "id": "feature_spec_2_title", "label": "Spec 2 title", "default": "CLEAN DESIGN" },
    { "type": "text", "id": "feature_spec_2_text", "label": "Spec 2 text", "default": "No visual noise or unnecessary setup friction." },
    { "type": "text", "id": "feature_spec_3_title", "label": "Spec 3 title", "default": "THEOS SUPPORT" },
    { "type": "text", "id": "feature_spec_3_text", "label": "Spec 3 text", "default": "Straight answers before and after your order." },

    { "type": "header", "content": "Product grid" },
    { "type": "collection", "id": "product_collection", "label": "Product collection" },
    { "type": "range", "id": "product_limit", "min": 3, "max": 9, "step": 3, "label": "Products to show", "default": 3 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "enable_filters", "label": "Enable product-type filters", "default": true },

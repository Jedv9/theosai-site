<section class="collections-page shell">
  <header class="page-hero">
    <p class="kicker"><span>Collections</span>Choose your line</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <div class="page-hero__text"><p>{{ section.settings.text | escape }}</p></div>
  </header>

  <div class="collections-grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a class="collection-tile" href="{{ collection.url }}">
          <div class="collection-tile__media">
            {%- assign collection_image = collection.image | default: collection.products.first.featured_image -%}
            {%- if collection_image -%}
              {{
                collection_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '420, 640, 860, 1200',
                  sizes: '(min-width: 900px) 33vw, 100vw',
                  alt: collection_image.alt
              }}
            {%- else -%}
              {% render 'product-art', art: 'mouse' %}
            {%- endif -%}
          </div>
          <div><span>{{ collection.products_count }} products</span><h2>{{ collection.title | escape }}</h2><i>↗</i></div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE PERFORMANCE COLLECTION."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Hardware selected to keep up with instinct."
    }
  ]
}
{% endschema %}

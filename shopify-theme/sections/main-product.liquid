<section class="main-product shell" data-product-section>
  <div class="product-gallery">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        <div class="product-gallery__item{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {{
                media
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '540, 720, 960, 1200, 1500, 1800',
                  sizes: '(min-width: 900px) 58vw, 100vw',
                  alt: media.alt
              }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, image_size: '1200x' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="product-gallery__item is-active product-gallery__placeholder">
        {% render 'product-art', art: 'mouse' %}
      </div>
    {%- endif -%}
  </div>

  <div class="product-info{% if section.settings.sticky_info %} product-info--sticky{% endif %}">
    <p class="kicker"><span>{{ product.type | default: 'Theos Gaming' | escape }}</span>{{ product.vendor | escape }}</p>
    <h1>{{ product.title | escape }}</h1>

    <div class="product-price" data-product-price>
      <strong>{{ product.selected_or_first_available_variant.price | money }}</strong>
      {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
        <s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
      {%- endif -%}
    </div>

    {%- if section.settings.show_tax_notice -%}
      <p class="product-tax-note">
        {%- if cart.taxes_included -%}Tax included.{%- endif -%}
        Shipping calculated at checkout.
      </p>
    {%- endif -%}

    {%- form 'product', product, class: 'product-form js-product-form', data-product-title: product.title -%}
      {%- unless product.has_only_default_variant -%}
        <label for="VariantSelect-{{ section.id }}">Choose options</label>
        <div class="select-wrap">
          <select id="VariantSelect-{{ section.id }}" name="id" data-variant-select>
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                data-price="{{ variant.price }}"
                data-compare-price="{{ variant.compare_at_price | default: 0 }}"
                data-available="{{ variant.available }}"
                {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}
              </option>
            {%- endfor -%}
          </select>
          <span>⌄</span>
        </div>
      {%- else -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {%- endunless -%}

      <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
      <div class="product-form__row">
        <div class="product-quantity">
          <button type="button" data-product-quantity-change="-1" aria-label="Decrease quantity"><svg><use href="#icon-minus"></use></svg></button>
          <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric">
          <button type="button" data-product-quantity-change="1" aria-label="Increase quantity"><svg><use href="#icon-plus"></use></svg></button>
        </div>
        <button
          class="button button--orange product-form__submit"
          type="submit"
          data-add-button
          data-ajax-add
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          <span data-add-label>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
          <svg><use href="#icon-plus"></use></svg>
        </button>
      </div>

      {%- if section.settings.show_dynamic_checkout -%}
        <div class="dynamic-checkout">{{ form | payment_button }}</div>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.trust_text != blank -%}
      <div class="product-trust"><svg><use href="#icon-check"></use></svg><span>{{ section.settings.trust_text | escape }}</span></div>
    {%- endif -%}

    <div class="product-description rte">{{ product.description }}</div>

    {%- if product.metafields.custom.specifications != blank -%}
      <div class="product-specifications">
        <h2>Specifications</h2>
        {{ product.metafields.custom.specifications | metafield_tag }}
      </div>
    {%- endif -%}

    <div class="product-accordions">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.heading | escape }}<span>+</span></summary>
          <div class="rte">{{ block.settings.content }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "Keep product information visible",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tax_notice",
      "label": "Show tax and shipping notice",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust message",
      "default": "Secure Shopify checkout · Tracked US delivery"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Information row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your shipping and returns information here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main product",
      "blocks": [
        { "type": "accordion", "settings": { "heading": "Shipping & returns", "content": "<p>Add your shipping and returns information here.</p>" } },
        { "type": "accordion", "settings": { "heading": "Warranty", "content": "<p>Add your warranty information here.</p>" } }
      ]
    }
  ]
}
{% endschema %}

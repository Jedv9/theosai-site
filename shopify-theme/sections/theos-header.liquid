{%- liquid
  assign threshold_cents = section.settings.free_shipping_threshold | times: 100
  assign remaining_cents = threshold_cents | minus: cart.total_price
  if threshold_cents > 0
    assign shipping_progress = cart.total_price | times: 100 | divided_by: threshold_cents
    if shipping_progress > 100
      assign shipping_progress = 100
    endif
  else
    assign shipping_progress = 100
  endif
-%}

<div class="announcement" aria-label="Store announcements">
  <div class="announcement__track">
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span><i></i>
    {%- endfor -%}
    {%- for block in section.blocks -%}
      <span aria-hidden="true">{{ block.settings.text | escape }}</span><i aria-hidden="true"></i>
    {%- endfor -%}
  </div>
</div>

<header class="site-header" data-site-header>
  <div class="header__inner shell">
    <button
      class="icon-button menu-trigger"
      type="button"
      aria-label="{{ 'general.accessibility.menu' | t }}"
      aria-controls="TheosMobileMenu-{{ section.id }}"
      aria-expanded="false"
      data-menu-trigger
    >
      <svg><use href="#icon-menu"></use></svg>
    </button>

    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 520
          | image_tag:
            widths: '120, 180, 240, 360, 520',
            width: settings.logo_width,
            class: 'brand__image',
            alt: shop.name
        }}
      {%- else -%}
        <svg class="brand__mark" viewBox="0 0 68 54" aria-hidden="true"><use href="#theos-mark"></use></svg>
        <span class="brand__word">
          <strong>{{ section.settings.brand_word | escape }}</strong>
          <small>{{ section.settings.brand_subline | escape }}</small>
        </span>
      {%- endif -%}
    </a>

    <nav class="main-nav" aria-label="Primary navigation">
      {%- if section.settings.use_shopify_menu and section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}#shop">Series 01</a>
        <a href="{{ routes.root_url }}#vx9">VX Series</a>
        <a href="{{ routes.root_url }}#engineering">Technology</a>
        <a href="{{ routes.root_url }}#manifesto">Our standard</a>
      {%- endif -%}
    </nav>

    <div class="header__actions">
      {%- if section.settings.enable_search -%}
        <button class="icon-button search-trigger" type="button" aria-label="{{ 'general.search.title' | t }}" data-search-trigger>
          <svg><use href="#icon-search"></use></svg>
        </button>
      {%- endif -%}
      <a class="icon-button account-link" href="{% if shop.customer_accounts_enabled %}{{ routes.account_url }}{% else %}{{ routes.root_url }}#newsletter{% endif %}" aria-label="Account">
        <svg><use href="#icon-user"></use></svg>
      </a>
      <button
        class="icon-button cart-trigger"
        type="button"
        aria-label="Open cart, {{ cart.item_count }} items"
        aria-controls="TheosCart-{{ section.id }}"
        data-cart-trigger
      >
        <svg><use href="#icon-bag"></use></svg>
        <span class="cart-count" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" id="TheosMobileMenu-{{ section.id }}" aria-label="Mobile navigation" hidden data-mobile-menu>
    {%- if section.settings.use_shopify_menu and section.settings.menu.links.size > 0 -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"><span>{{ forloop.index | prepend: '0' }}</span>{{ link.title | escape }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ routes.root_url }}#shop"><span>01</span>Series 01</a>
      <a href="{{ routes.root_url }}#vx9"><span>02</span>VX Series</a>
      <a href="{{ routes.root_url }}#engineering"><span>03</span>Technology</a>
      <a href="{{ routes.root_url }}#manifesto"><span>04</span>Our standard</a>
    {%- endif -%}
    <p>{{ section.settings.mobile_tagline | escape }}</p>
  </nav>
</header>

<div class="drawer-backdrop" data-drawer-backdrop></div>

<aside
  class="cart-drawer"
  id="TheosCart-{{ section.id }}"
  aria-label="{{ 'cart.title' | t }}"
  aria-hidden="true"
  data-cart-drawer
  data-free-shipping-threshold="{{ threshold_cents }}"
  inert
>
  <div class="drawer__head">
    <div>
      <span>{{ 'cart.title' | t }}</span>
      <strong><span data-cart-count-text>{{ cart.item_count }}</span> items</strong>
    </div>
    <button class="icon-button cart-close" type="button" aria-label="{{ 'general.accessibility.close' | t }}" data-cart-close>
      <svg><use href="#icon-close"></use></svg>
    </button>
  </div>

  {%- if section.settings.free_shipping_threshold > 0 -%}
    <div class="shipping-meter">
      <p data-shipping-message>
        {%- if remaining_cents <= 0 -%}
          Free shipping unlocked
        {%- else -%}
          Add {{ remaining_cents | money }} for free shipping
        {%- endif -%}
      </p>
      <span><i data-shipping-progress style="width: {{ shipping_progress }}%"></i></span>
    </div>
  {%- endif -%}

  <div class="cart-items" data-cart-items{% if cart.empty? %} hidden{% endif %}>
    {%- for item in cart.items -%}
      <article class="cart-line" data-cart-line="{{ forloop.index }}">
        <a class="cart-line__visual" href="{{ item.url }}">
          {%- if item.image -%}
            {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt }}
          {%- endif -%}
        </a>
        <div class="cart-line__main">
          <div class="cart-line__title">
            <p>
              <strong><a href="{{ item.url }}">{{ item.product.title | escape }}</a></strong>
              {%- unless item.product.has_only_default_variant -%}<span>{{ item.variant.title | escape }}</span>{%- endunless -%}
            </p>
            <button class="cart-remove" type="button" data-cart-remove="{{ forloop.index }}" aria-label="Remove {{ item.product.title | escape }}">×</button>
          </div>
          <div class="cart-line__bottom">
            <div class="quantity" aria-label="Quantity for {{ item.product.title | escape }}">
              <button type="button" data-cart-change="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">
                <svg><use href="#icon-minus"></use></svg>
              </button>
              <span>{{ item.quantity }}</span>
              <button type="button" data-cart-change="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">
                <svg><use href="#icon-plus"></use></svg>
              </button>
            </div>
            <strong>{{ item.final_line_price | money }}</strong>
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>

  <div class="cart-empty" data-cart-empty{% unless cart.empty? %} hidden{% endunless %}>
    <span>00</span>
    <h2>{{ 'cart.empty' | t }}</h2>
    <p>Start with hardware engineered to keep up.</p>
    <a class="button button--orange" href="{{ routes.all_products_collection_url }}">Shop the collection</a>
  </div>

  <div class="cart-footer" data-cart-footer{% if cart.empty? %} hidden{% endif %}>
    <div><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-subtotal>{{ cart.total_price | money }}</strong></div>
    <p>Taxes and shipping calculated at checkout.</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button class="button button--orange" type="submit" name="checkout">
        {{ 'cart.checkout' | t }} <svg><use href="#icon-arrow"></use></svg>
      </button>
    </form>
    <a class="cart-view-link" href="{{ routes.cart_url }}">View full cart</a>
  </div>
</aside>

{%- if section.settings.enable_search -%}
  <section class="search-drawer" aria-label="{{ 'general.search.title' | t }}" aria-hidden="true" data-search-drawer inert>
    <div class="search__inner shell">
      <div class="search__head">
        <span>SEARCH THE GRID</span>
        <button class="icon-button search-close" type="button" aria-label="{{ 'general.accessibility.close' | t }}" data-search-close>
          <svg><use href="#icon-close"></use></svg>
        </button>
      </div>
      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search" data-predictive-search-form>
        <label class="sr-only" for="TheosSearch-{{ section.id }}">{{ 'general.search.title' | t }}</label>
        <input
          id="TheosSearch-{{ section.id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          data-predictive-search-input
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="{{ 'general.search.submit' | t }}"><svg><use href="#icon-arrow"></use></svg></button>
      </form>
      <div class="predictive-results" data-predictive-results aria-live="polite"></div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Theos header",
  "class": "theos-header-section",
  "settings": [
    {
      "type": "text",
      "id": "brand_word",
      "label": "Fallback brand word",
      "default": "THEOS"
    },
    {
      "type": "text",
      "id": "brand_subline",
      "label": "Fallback brand subline",
      "default": "GAMING"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "use_shopify_menu",
      "label": "Use selected Shopify menu",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable predictive search",
      "default": true
    },
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "$",
      "label": "Free shipping threshold",
      "default": 75
    },
    {
      "type": "text",
      "id": "mobile_tagline",
      "label": "Mobile menu tagline",
      "default": "PRECISION // WITHOUT COMPROMISE"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Series 01 now in development"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Theos header",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Series 01 now in development" } },
        { "type": "announcement", "settings": { "text": "Engineered from first principles" } },
        { "type": "announcement", "settings": { "text": "Join the launch grid" } }
      ]
    }
  ]
}
{% endschema %}

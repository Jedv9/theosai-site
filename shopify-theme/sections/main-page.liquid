<section class="content-page shell">
  <header class="page-hero page-hero--compact">
    <p class="kicker"><span>{{ section.settings.eyebrow | escape }}</span>{{ shop.name | escape }}</p>
    <h1>{{ page.title | escape }}</h1>
  </header>
  <div class="content-page__body rte">{{ page.content }}</div>
</section>

{% schema %}
{
  "name": "Main page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Information"
    }
  ]
}
{% endschema %}

<footer class="site-footer">
  <div class="footer__top shell">
    <a class="brand brand--footer" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 520
          | image_tag:
            widths: '120, 180, 240, 360, 520',
            width: settings.logo_width,
            class: 'brand__image',
            alt: shop.name
        }}
      {%- else -%}
        <svg class="brand__mark" viewBox="0 0 68 54" aria-hidden="true"><use href="#theos-mark"></use></svg>
        <span class="brand__word"><strong>{{ section.settings.brand_word | escape }}</strong><small>{{ section.settings.brand_subline | escape }}</small></span>
      {%- endif -%}
    </a>
    <p>{{ section.settings.tagline | escape }}</p>
  </div>

  <div class="footer__grid shell">
    {%- if section.settings.use_shopify_menus -%}
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading | escape }}</h3>
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- endfor -%}
            {%- when 'contact' -%}
              {%- if block.settings.email != blank -%}
                <a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape | newline_to_br }}</p>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div>
        <h3>Series 01</h3>
        <a href="{{ routes.root_url }}#products">Mice</a>
        <a href="{{ routes.root_url }}#products">Keyboards</a>
        <a href="{{ routes.root_url }}#products">Desks</a>
        <a href="{{ routes.root_url }}#vx9">Development concepts</a>
      </div>
      <div>
        <h3>Explore</h3>
        <a href="{{ routes.root_url }}#engineering">Technology</a>
        <a href="{{ routes.root_url }}#manifesto">Our standard</a>
        <a href="{{ routes.root_url }}#newsletter">Theos signal</a>
        <a href="{{ routes.root_url }}#top">Setup gallery</a>
      </div>
      <div>
        <h3>Support</h3>
        <a href="mailto:{{ section.settings.support_email | default: 'support@theosgaming.com' }}">Contact</a>
        <a href="{{ shop.shipping_policy.url | default: routes.root_url }}">Shipping &amp; returns</a>
        <a href="{{ shop.refund_policy.url | default: routes.root_url }}">Warranty</a>
        <a href="{{ routes.root_url }}">Downloads</a>
      </div>
    {%- endif -%}

    <div class="footer__social">
      <h3>{{ section.settings.social_heading | escape }}</h3>
      <div>
        <a href="{{ settings.social_instagram | default: routes.root_url }}" {% if settings.social_instagram != blank %}target="_blank" rel="noopener"{% endif %} aria-label="Instagram">IG</a>
        <a href="{{ settings.social_tiktok | default: routes.root_url }}" {% if settings.social_tiktok != blank %}target="_blank" rel="noopener"{% endif %} aria-label="TikTok">TK</a>
        <a href="{{ settings.social_youtube | default: routes.root_url }}" {% if settings.social_youtube != blank %}target="_blank" rel="noopener"{% endif %} aria-label="YouTube">YT</a>
        <a href="{{ settings.social_discord | default: routes.root_url }}" {% if settings.social_discord != blank %}target="_blank" rel="noopener"{% endif %} aria-label="Discord">DC</a>
      </div>
    </div>
  </div>

  {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
    <div class="footer__localization shell">
      {%- form 'localization', id: 'FooterLocalizationForm' -%}
        {%- if localization.available_countries.size > 1 -%}
          <label for="FooterCountry">Country/region</label>
          <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        {%- if localization.available_languages.size > 1 -%}
          <label for="FooterLanguage">Language</label>
          <select id="FooterLanguage" name="locale_code" onchange="this.form.submit()">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                {{ language.endonym_name | capitalize }}
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="footer__bottom shell">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
    <span>{{ section.settings.bottom_line | escape }}</span>
    <div>
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Theos footer",
  "class": "theos-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "brand_word",
      "label": "Fallback brand word",
      "default": "THEOS"
    },
    {
      "type": "text",
      "id": "brand_subline",
      "label": "Fallback brand subline",
      "default": "GAMING"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "PRECISION // WITHOUT COMPROMISE"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Follow the signal"
    },
    {
      "type": "text",
      "id": "bottom_line",
      "label": "Footer bottom line",
      "default": "Designed for the last millisecond."
    },
    {
      "type": "checkbox",
      "id": "use_shopify_menus",
      "label": "Use menu blocks instead of Theos links",
      "default": false
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "support@theosgaming.com"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Support"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Support email"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Theos footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Explore" } },
        { "type": "contact", "settings": { "heading": "Support", "text": "Questions about your setup? We are here to help." } }
      ]
    }
  ]
}
{% endschema %}

<footer class="site-footer">
  <div class="footer__top shell">
    <a class="brand brand--footer" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 520
          | image_tag:
            widths: '120, 180, 240, 360, 520',
            width: settings.logo_width,
            class: 'brand__image',
            alt: shop.name
        }}
      {%- else -%}
        <svg class="brand__mark" viewBox="0 0 68 54" aria-hidden="true"><use href="#theos-mark"></use></svg>
        <span class="brand__word"><strong>{{ section.settings.brand_word | escape }}</strong><small>{{ section.settings.brand_subline | escape }}</small></span>
      {%- endif -%}
    </a>
    <p>{{ section.settings.tagline | escape }}</p>
  </div>

  <div class="footer__grid shell">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h3>{{ block.settings.heading | escape }}</h3>
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- endfor -%}
          {%- when 'contact' -%}
            {%- if block.settings.email != blank -%}
              <a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape | newline_to_br }}</p>
            {%- endif -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}

    <div class="footer__social">
      <h3>{{ section.settings.social_heading | escape }}</h3>
      <div>
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">IG</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">TK</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">YT</a>{%- endif -%}
        {%- if settings.social_discord != blank -%}<a href="{{ settings.social_discord }}" target="_blank" rel="noopener" aria-label="Discord">DC</a>{%- endif -%}
        {%- if settings.social_instagram == blank and settings.social_tiktok == blank and settings.social_youtube == blank and settings.social_discord == blank -%}
          <span class="footer__social-empty">Add social links in theme settings</span>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
    <div class="footer__localization shell">
      {%- form 'localization', id: 'FooterLocalizationForm' -%}
        {%- if localization.available_countries.size > 1 -%}
          <label for="FooterCountry">Country/region</label>
          <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        {%- if localization.available_languages.size > 1 -%}
          <label for="FooterLanguage">Language</label>
          <select id="FooterLanguage" name="locale_code" onchange="this.form.submit()">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                {{ language.endonym_name | capitalize }}
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="footer__bottom shell">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span>
    <span>{{ section.settings.bottom_line | escape }}</span>
    <div>
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Theos footer",
  "class": "theos-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "brand_word",
      "label": "Fallback brand word",
      "default": "THEOS"
    },
    {
      "type": "text",
      "id": "brand_subline",
      "label": "Fallback brand subline",
      "default": "GAMING"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "PRECISION // WITHOUT COMPROMISE"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Follow the signal"
    },
    {
      "type": "text",
      "id": "bottom_line",
      "label": "Footer bottom line",
      "default": "Designed for the last millisecond."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Support"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Support email"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Theos footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Explore" } },
        { "type": "contact", "settings": { "heading": "Support", "text": "Questions about your setup? We are here to help." } }
      ]
    }
  ]
}
{% endschema %}

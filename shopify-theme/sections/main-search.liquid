<section class="search-page shell">
  <header class="page-hero page-hero--compact">
    <p class="kicker"><span>Search</span>The grid</p>
    <h1>{% if search.performed %}RESULTS FOR<br>“{{ search.terms | escape }}”{% else %}FIND YOUR<br>ADVANTAGE.{% endif %}</h1>
  </header>

  <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="sr-only" for="SearchPageInput">{{ 'general.search.title' | t }}</label>
    <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button type="submit"><svg><use href="#icon-arrow"></use></svg><span class="sr-only">{{ 'general.search.submit' | t }}</span></button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.results_per_page -%}
      <p class="search-page__count">{{ search.results_count }} results</p>
      <div class="product-grid product-grid--collection">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- liquid
              assign product_type_handle = item.type | handleize
              case product_type_handle
                when 'keyboard', 'keyboards'
                  assign fallback_art = 'keyboard'
                  assign color_style = 'silver'
                when 'desk', 'desks'
                  assign fallback_art = 'desk'
                  assign color_style = 'cream'
                else
                  assign fallback_art = 'mouse'
                  assign color_style = 'orange'
              endcase
            -%}
            {% render 'product-card',
              product_card_product: item,
              fallback_art: fallback_art,
              color_style: color_style,
              show_vendor: false,
              card_index: forloop.index
            %}
          {%- endif -%}
        {%- else -%}
          <div class="empty-state">
            <h2>{{ 'general.search.no_results' | t }}</h2>
            <p>Try a product type, feature, or collection name.</p>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Previous</a>{%- endif -%}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 6,
      "max": 36,
      "step": 3,
      "label": "Results per page",
      "default": 12
    }
  ]
}
{% endschema %}

[
  {
    "name": "theme_info",
    "theme_name": "Theos Gaming",
    "theme_version": "1.2.2",
    "theme_author": "Theos Gaming",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 90,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Racing accent",
        "default": "#ff4e00"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Dark background",
        "default": "#050505"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Raised surface",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Warm white",
        "default": "#f2f0e9"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Store mode",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_commerce",
        "label": "Enable prices, cart, and checkout",
        "default": false
      },
      {
        "type": "text",
        "id": "concept_label",
        "label": "Concept status label",
        "default": "IN DEVELOPMENT"
      },
      {
        "type": "text",
        "id": "concept_cta",
        "label": "Concept call to action",
        "default": "JOIN THE LAUNCH GRID"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "oswald_n700"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_discord",
        "label": "Discord URL"
      }
    ]
  }
]

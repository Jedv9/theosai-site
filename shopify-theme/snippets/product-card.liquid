{%- liquid
  assign card_product = product_card_product
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_art = fallback_art | default: 'mouse'
  assign card_badge = card_product.metafields.custom.badge.value
  if settings.enable_commerce
    if card_badge == blank and card_product.compare_at_price > card_product.price
      assign card_badge = 'Sale'
    endif
  else
    assign card_badge = settings.concept_label
  endif
-%}

<article
  class="product-card reveal"
  data-category="{{ card_product.type | handleize }}"
  data-product-handle="{{ card_product.handle }}"
>
  <div class="product-card__visual product-card__visual--{{ color_style | default: 'orange' }}">
    {%- if card_badge != blank -%}
      <span class="product-badge">{{ card_badge | escape }}</span>
    {%- elsif card_product.available -%}
      <span class="product-badge">Ready to ship</span>
    {%- else -%}
      <span class="product-badge">Sold out</span>
    {%- endif -%}

    {%- if settings.enable_commerce -%}
      {%- if card_product.has_only_default_variant and card_product.available -%}
        <form
          method="post"
          action="{{ routes.cart_add_url }}"
          class="quick-add-form js-product-form"
          data-product-title="{{ card_product.title | escape }}"
        >
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="quick-add" type="submit" data-ajax-add aria-label="Add {{ card_product.title | escape }} to cart">
            <svg><use href="#icon-plus"></use></svg>
          </button>
        </form>
      {%- else -%}
        <a class="quick-add" href="{{ card_product.url }}" aria-label="Choose options for {{ card_product.title | escape }}">
          <svg><use href="#icon-arrow"></use></svg>
        </a>
      {%- endif -%}
    {%- else -%}
      <a class="quick-add" href="{{ card_product.url }}" aria-label="View {{ card_product.title | escape }}">
        <svg><use href="#icon-arrow"></use></svg>
      </a>
    {%- endif -%}

    <a class="product-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
      {%- if card_product.featured_image -%}
        {{
          card_product.featured_image
          | image_url: width: 1000
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900, 1000',
            sizes: '(min-width: 990px) 33vw, (min-width: 650px) 50vw, 100vw',
            class: 'product-card__image',
            alt: card_product.featured_image.alt
        }}
        {%- if card_product.images[1] != blank -%}
          {{
            card_product.images[1]
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '360, 540, 720, 900, 1000',
              sizes: '(min-width: 990px) 33vw, (min-width: 650px) 50vw, 100vw',
              class: 'product-card__image product-card__image--hover',
              alt: card_product.images[1].alt
          }}
        {%- endif -%}
      {%- else -%}
        {% render 'product-art', art: card_art %}
      {%- endif -%}
    </a>

    <span class="product-code">{{ card_product.type | default: 'THEOS' | upcase }} // {{ card_index | default: '01' | prepend: '0' | slice: -2, 2 }}</span>
  </div>

  <div class="product-card__info">
    <div>
      {%- if show_vendor and card_product.vendor != blank -%}
        <p>{{ card_product.vendor | escape }}</p>
      {%- else -%}
        <p>{{ card_product.type | default: 'Theos performance' | escape }}</p>
      {%- endif -%}
      <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      {%- if card_product.metafields.custom.short_description != blank -%}
        <span>{{ card_product.metafields.custom.short_description.value | escape }}</span>
      {%- else -%}
        <span>{{ card_product.description | strip_html | truncate: 74 }}</span>
      {%- endif -%}
    </div>
    <div class="product-card__price">
      {%- if settings.enable_commerce -%}
        {%- if card_product.price_varies -%}<small>From</small>{%- endif -%}
        <strong>{{ card_product.price | money }}</strong>
        {%- if card_product.compare_at_price > card_product.price -%}
          <s>{{ card_product.compare_at_price | money }}</s>
        {%- endif -%}
      {%- else -%}
        <small>Series 01</small>
        <strong class="concept-status">{{ settings.concept_label | escape }}</strong>
      {%- endif -%}
    </div>
  </div>
</article>
